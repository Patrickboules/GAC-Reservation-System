# Supabase project URL and anon (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_
# and never import lib/supabase/admin.ts from client components.
SUPABASE_SERVICE_ROLE_KEY=
