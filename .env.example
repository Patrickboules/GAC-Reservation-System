# Supabase project URL — Project Settings > Data API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key — Project Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase anon (legacy JWT-based) key — Project Settings > API Keys > Legacy API keys > anon/public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — server-only, bypasses RLS. Project Settings > API Keys > Legacy API keys > service_role.
# Never prefix with NEXT_PUBLIC_ and never import lib/supabase/admin.ts from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth credentials — used by the Supabase Google provider ([auth.external.google] in
# supabase/config.toml). Create them in Google Cloud Console > APIs & Services > Credentials
# (OAuth client ID, type "Web application"). See DEPLOYMENT.md for the full setup steps.
# Never commit real values.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-oauth-client-secret
